+#[derive(serde::Serialize, serde::Deserialize)]
+struct CachedTomlManifest {
+    manifest: manifest::TomlManifest,
+    unused_keys: BTreeSet<String>,
+}
+
+#[tracing::instrument(skip_all)]
+fn deserialize_cached_toml(
+    contents: &str,
+    gctx: &GlobalContext,
+) -> Result<manifest::TomlManifest, toml::de::Error> {
+    let hash = blake3::hash(contents.as_bytes()).to_hex().to_string();
+    let cache_dir = gctx.home().join("manifest-cache-experiment");
+    let cache_file = cache_dir.join(format!("{hash}.json"));
+
+    if let Ok(bytes) = std::fs::read(cache_file.as_path_unlocked()) {
+        if let Ok(mut cached) = serde_json::from_slice::<CachedTomlManifest>(&bytes) {
+            cached.manifest._unused_keys = cached.unused_keys;
+            return Ok(cached.manifest);
+        }
+    }
+
+    let deserializer = toml::de::Deserializer::parse(contents)?;
+    let manifest = deserialize_toml(deserializer)?;
+
+    let cached = CachedTomlManifest {
+        unused_keys: manifest._unused_keys.clone(),
+        manifest: manifest.clone(),
+    };
+    if let Ok(bytes) = serde_json::to_vec(&cached) {
+        if std::fs::create_dir_all(cache_dir.as_path_unlocked()).is_ok() {
+            let _ = std::fs::write(cache_file.as_path_unlocked(), bytes);
+        }
+    }
+
+    Ok(manifest)
+}
